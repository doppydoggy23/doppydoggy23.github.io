
mapfab(raw, "dynbg3.mapfab", "chr", "palette", "metatiles", "level")


data /romdata
    [] screen1
        file(raw, "screen1.nam")
    [] screen2
        file(raw, "screen2.nam")


ct U NUM_FPS=60
ct U RAIN_FPS_WAIT=5
ct U RAY_FPS_WAIT=60
ct U RAY_DURATION=10

vars /game_vars

    U curr_frames=0
    U pal_num=0
    U ray_frames=0

//    U[4] rain_pal_1 = U[4]($30, $0F, $0F, $0F) // the 3 colors of a pallete, plus the UBG color
//    U[4] rain_pal_2 = U[4]($0F, $30, $0F, $0F) // the 3 colors of a pallete, plus the UBG color
    U[8] flash_pal = U[8]($0F, $00, $10, $20, $10, $00, $0F, $0F)

////////

// entrance point NMI
nmi main_nmi()
    // Update OAM and poll the pads:
    ppu_upload_oam_poll_pads(0)
    // upload palette
    ppu_upload_palette()
    // Turn on rendering:
    {PPUMASK}(PPUMASK_ON | PPUMASK_NO_CLIP)
    // Reset the scroll
    ppu_reset_scroll(0, 0)
    //
    fence
    {PPUSTATUS}() // we need to read PPUSTATUS to avoid triggering a double NMI
    fence
    {PPUCTRL}(PPUCTRL_NMI_ON) // Investigate why I have to put this to start at nametable $2000, is this some kind of NES bug when ppu_upload_pallete()?


// entrance point function
mode main()
: nmi main_nmi
    //
    {PPUCTRL}(0)  // Reset PPU control register for new level
    {PPUMASK}(0) // Reset PPU mask register for new level
    // load start screen made in NEXXT
    ppu_reset_addr($2000)
    for UU i=0; i<1024; i+=1
        {PPUDATA}(@screen2{i})
    //
    curr_frames=0
    pal_num=0
    ray_frames=0
    //
    palette[0]=$0F
    palette[1]=$0F
    palette[2]=$0F
    palette[24]=$0F
    ppu_upload_palette()
    //
    fence
    {PPUSTATUS}() // we need to read PPUSTATUS to avoid triggering a double NMI
    fence
    {PPUCTRL}(PPUCTRL_NMI_ON)
    //

    while true
        update_pads()
        move_player()
        update_sprites() 
        // Rain
        if (curr_frames>=RAIN_FPS_WAIT)
            curr_frames=0
            //
            if (pal_num==0)
                palette[0]=$11
                palette[1]=$0F
            else
                if (pal_num==1)
                    palette[0]=$0F
                    palette[1]=$11
            pal_num+=1
            if (pal_num>1)
                pal_num=0

        else
            curr_frames+=1
        // Thunders
        if (ray_frames>=RAY_FPS_WAIT)
            if (ray_frames>(RAY_FPS_WAIT+RAY_DURATION))
                ray_frames=0
                palette[2]=$0F
            else
                palette[2]=$38
        // Sky Flash
        if (ray_frames>=RAY_FPS_WAIT)
            U f_pal_i=ray_frames-RAY_FPS_WAIT
            if (f_pal_i<8)
                palette[24]=flash_pal[f_pal_i]
        //
        ray_frames+=1
        //
        nmi // Wait for the next NMI
    //


//////////

