    while true
        update_pads()
        move_player()
        update_animation() // before update sprites
        update_sprites() 
        check_if_success()
        //
        frame_counter+=1
        if (frame_counter>NUM_FRAMES_PER_SEC)
            frame_counter=0
            update_time() // updates the seconds, minutes, and hours passed since level start
        //
        nmi // Wait for the next NMI
    //

